# MongoDB Atlas Connection String (Required)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="khabgah_db"

# Comma-separated CORS origin allowlist (leave empty only for initial testing)
# Example: https://your-app.vercel.app,https://ai.studio,http://localhost:3000
ALLOWED_ORIGINS=""

# Optional shared secret token for mutating API routes (set VITE_CLOUD_SYNC_TOKEN in frontend to match)
CLOUD_SYNC_API_TOKEN=""

# Optional public URL used when returning binary photo URLs
PUBLIC_API_BASE_URL=""

# Optional Gemini API key for /api/ai-chat
GEMINI_API_KEY=""

# Standalone server port
PORT=4000
